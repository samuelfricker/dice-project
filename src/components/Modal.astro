---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog id={id} class="modal-dialog">
  <div class="modal-content">
    <header class="modal-header">
      <h2>{title}</h2>
      <button type="button" class="close-button" data-close-modal aria-label="Close modal">&times;</button>
    </header>
    <div class="modal-body">
      <slot />
    </div>
    <footer class="modal-footer">
      <button type="button" class="btn btn-primary" data-close-modal>Close</button>
    </footer>
  </div>
</dialog>

<script>
  // Handle closing modals via buttons
  const closeButtons = document.querySelectorAll('[data-close-modal]');
  closeButtons.forEach(button => {
    button.addEventListener('click', () => {
      const dialog = button.closest('dialog');
      if (dialog) {
        dialog.close();
      }
    });
  });

  // Close when clicking backdrop
  const dialogs = document.querySelectorAll('.modal-dialog');
  dialogs.forEach(dialog => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        (dialog as HTMLDialogElement).close();
      }
    });
  });
</script>

<style>
  .modal-dialog {
    padding: 0;
    border: none;
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    max-width: 500px;
    width: 90%;
  }

  .modal-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    background-color: var(--bg-color-alt, #ffffff);
    color: var(--text-color, #1a1a1a);
    display: flex;
    flex-direction: column;
  }

  .modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--accent-color, #0056b3);
  }

  .close-button {
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-color-light, #6b7280);
    padding: 0;
  }

  .modal-body {
    padding: 1.5rem;
    line-height: 1.6;
  }

  .modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
    display: flex;
    justify-content: flex-end;
  }

  .btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: var(--accent-color, #0056b3);
    color: white;
    border: 1px solid var(--accent-color, #0056b3);
  }

  .btn-primary:hover {
    background-color: var(--accent-hover, #004494);
  }
</style>
