---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
            <h1 id="hero-title">
                Digital Inclusion through Cybersecurity and Ethical AI
            </h1>
            <p class="subtitle">
                Empowering vocational education and training across Europe with
                accessible, cutting-edge digital skills.
            </p>
            <div class="hero-actions">
                <a href="/e-learning" class="btn btn-primary"
                    >Go to E-Learning Platform</a
                >
            </div>
        </div>
    </section>

    <section id="about" class="about-project" aria-labelledby="about-title">
        <h2 id="about-title">About the DICE Project</h2>
        <div class="content-grid">
            <div class="card">
                <h3>Project Objectives</h3>
                <p>
                    The DICE project bridges the digital divide by building an
                    accessible Erasmus+ funded e-learning platform. Developed
                    collaboratively by partners in Germany, Italy, and Bulgaria,
                    it provides specialized training in practical cybersecurity
                    and applied ethical AI.
                </p>
            </div>
            <div class="card">
                <h3>C-VET Learners</h3>
                <p>
                    Continuing Vocational Education and Training (C-VET)
                    learners gain direct, free access to our inclusive
                    e-learning platform. They acquire concrete skills in data
                    protection, secure digital practices, and ethical AI to
                    remain competitive in the European labor market.
                </p>
            </div>
            <div class="card">
                <h3>VET Providers</h3>
                <p>
                    Vocational Education and Training (VET) providers receive
                    ready-to-use, highly accessible training modules. By
                    integrating our specialized curriculum into their programs,
                    educators can effectively teach cybersecurity and AI
                    concepts to adult learners across Europe.
                </p>
            </div>
        </div>
    </section>
</Layout>

<style>
    .hero {
        background-color: var(--bg-color-alt);
        padding: 5rem 2rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 4rem;
        box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.1),
            0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid var(--border-color);
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .hero-content h1 {
        font-size: 2.75rem;
        color: var(--text-color);
        margin-bottom: 1.5rem;
        letter-spacing: -0.025em;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--text-color-light);
        max-width: 700px;
        margin: 0 auto 2.5rem auto;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.875rem 1.75rem;
        border-radius: 8px;
        font-size: 1.125rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background-color: var(--accent-color);
        color: #ffffff;
        border: 2px solid var(--accent-color);
    }

    .btn-primary:hover,
    .btn-primary:focus-visible {
        background-color: var(--accent-hover);
        border-color: var(--accent-hover);
        color: #ffffff;
        text-decoration: none;
    }

    .btn-secondary {
        background-color: transparent;
        color: var(--accent-color);
        border: 2px solid var(--accent-color);
    }

    .btn-secondary:hover,
    .btn-secondary:focus-visible {
        background-color: var(--accent-color);
        color: #ffffff;
        text-decoration: none;
    }

    .about-project {
        margin-bottom: 4rem;
    }

    .about-project h2 {
        font-size: 2.25rem;
        text-align: center;
        margin-bottom: 3rem;
        color: var(--text-color);
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
    }

    .card {
        background-color: var(--bg-color-alt);
        padding: 2.5rem;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .card h3 {
        color: var(--accent-color);
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .card p {
        color: var(--text-color-light);
        margin: 0;
        line-height: 1.6;
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 1.5rem;
        }

        .hero-content h1 {
            font-size: 2.25rem;
        }

        .hero-actions {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
        }

        .card {
            padding: 2rem;
        }
    }
</style>
